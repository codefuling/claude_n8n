      "id": "c1",
      "name": "할 일 구성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        100
      ],
      "parameters": {
        "jsCode": "// Webhook body: { \"date\": \"2026-11-11\", \"title\": \"빼빼로 선물\", \"description\": \"...\" }  (수동 실행 시 기본값 사용)\nconst src = $input.first().json;\nconst b = src.body || src;\nconst kstToday = new Date().toLocaleDateString('sv-SE', { timeZone: 'Asia/Seoul' });\nlet date = String(b.date || '2026-11-11');\n// \"11-11\" 또는 \"11월 11일\" 형태면 올해 날짜로 보정\nconst m = date.match(/^(?:(\\d{4})[-.])?(\\d{1,2})[-.월\\s]+(\\d{1,2})/);\nif (m) date = `${m[1] || kstToday.slice(0, 4)}-${m[2].padStart(2, '0')}-${m[3].padStart(2, '0')}`;\nconst title = String(b.title || '빼빼로 선물').slice(0, 50);\nconst next = new Date(date + 'T00:00:00Z');\nnext.setUTCDate(next.getUTCDate() + 1);\nconst event = {\n  title,\n  time: { start_at: date + 'T00:00:00Z', end_at: next.toISOString().slice(0, 19) + 'Z', time_zone: 'Asia/Seoul', all_day: true, lunar: false },\n  description: String(b.description || 'n8n으로 등록한 할 일'),\n  reminders: [],\n};\nreturn [{ json: { event: JSON.stringify(event), title, date } }];"
      }
    },
