              "neverError": true
            }
          }
        }
      },
      "id": "g1",
      "name": "GitHub 기존 파일 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        848,
        112
      ],
      "credentials": {
        "githubApi": {
          "id": "cuzxNQoCBmZXwekK",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 기존 파일(sha, content)과 비교해 변경된 워크플로우만 커밋 대상으로 남긴다\nconst built = $('백업 파일 구성').all();\nconst out = [];\n$input.all().forEach((it, i) => {\n  const b = built[i].json;\n  const ex = it.json || {};\n  const exists = !!ex.sha;\n  const same = exists && String(ex.content || '').replace(/\\n/g, '') === b.content;\n  if (same) return;\n  const body = { message: b.message, content: b.content, branch: b.branch };\n  if (exists) body.sha = ex.sha;\n  out.push({ json: { name: b.name, url: b.url, action: exists ? 'update' : 'create', body: JSON.stringify(body) } });\n});\nreturn out;"
      },
