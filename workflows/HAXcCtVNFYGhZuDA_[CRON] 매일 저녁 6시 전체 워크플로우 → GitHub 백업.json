    {
      "parameters": {
        "jsCode": "// ===== 설정: GitHub 백업 저장소 (본인 값으로 교체) =====\nconst OWNER = 'codefuling';\nconst REPO = 'claude_n8n';\nconst BRANCH = 'main';\nconst DIR = 'workflows';\n// =====================================================\nconst kst = new Date().toLocaleString('sv-SE', { timeZone: 'Asia/Seoul' });\nconst safe = (s) => String(s).replace(/[\\\\/:*?\"<>|]/g, '_').replace(/\\s+/g, ' ').trim().slice(0, 80);\nreturn $input.all().map(({ json: w }) => {\n  // 실행 데이터가 섞인 pinData / staticData 는 백업에서 제외\n  const { pinData, staticData, ...clean } = w;\n  const path = `${DIR}/${w.id}_${safe(w.name)}.json`;\n  const content = Buffer.from(JSON.stringify(clean, null, 2), 'utf8').toString('base64');\n  const url = `https://api.github.com/repos/${OWNER}/${REPO}/contents/${path.split('/').map(encodeURIComponent).join('/')}`;\n  return { json: { id: w.id, name: w.name, path, content, url, branch: BRANCH, message: `backup: ${w.name} (${kst} KST)` } };\n});"
      },
      "id": "c1",
      "name": "백업 파일 구성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        112
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
