      "parameters": {
        "method": "POST",
        "url": "https://api.firecrawl.dev/v1/scrape",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: \"https://www.melon.com/chart/index.htm\", formats: [\"rawHtml\"], onlyMainContent: false, waitFor: 2000 }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "fc1",
      "name": "Firecrawl 멜론차트 크롤링",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "position": [
        240,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "bCWz8YWrsk8BbV1z",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const first = $input.first().json;\nconst html = first.data?.rawHtml ?? first.data?.html ?? '';\nconst dec = s => s.replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&#0?39;/g, \"'\").replace(/&(Eacute|eacute|Egrave|egrave|Aacute|aacute|Oacute|oacute|Uacute|uacute|Iacute|iacute|ntilde|Ntilde|ccedil|uuml|ouml|auml);/g, (_, n) => ({ Eacute: 'É', eacute: 'é', Egrave: 'È', egrave: 'è', Aacute: 'Á', aacute: 'á', Oacute: 'Ó', oacute: 'ó', Uacute: 'Ú', uacute: 'ú', Iacute: 'Í', iacute: 'í', ntilde: 'ñ', Ntilde: 'Ñ', ccedil: 'ç', uuml: 'ü', ouml: 'ö', auml: 'ä' })[n]).replace(/\\s+/g, ' ').trim();\nconst rows = html.split(/<tr class=\"lst\\d+\"/).slice(1);\nconst songs = [];\nconst seen = new Set();\nfor (const r of rows) {\n  const id = (r.match(/data-song-no=\"(\\d+)\"/) || [])[1];\n  if (!id || seen.has(id)) continue;\n  const rank = Number((r.match(/<span class=\"rank\\s*\">(\\d+)<\\/span>/) || [])[1]);\n  const title = dec((r.match(/rank01\">\\s*<span>\\s*<a[^>]*>([\\s\\S]*?)<\\/a>/) || [])[1] || '');\n  const artBlock = (r.match(/rank02\">([\\s\\S]*?)<span class=\"checkEllipsis\"/) || [])[1] || '';\n  const artist = [...artBlock.matchAll(/<a[^>]*>([\\s\\S]*?)<\\/a>/g)].map(m => dec(m[1])).join(', ');\n  seen.add(id);\n  songs.push({ id, rank, title, artist });\n}\nif (!songs.length) throw new Error('멜론 차트 데이터를 파싱하지 못했습니다. Firecrawl 응답(data.rawHtml)을 확인하세요.');\nreturn [{ json: { songs, ids: songs.map(s => s.id).join(',') } }];\n"
      },
      "id": "c1",
      "name": "곡 정보 파싱",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
