      "id": "lk1",
      "name": "좋아요 수 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const songs = $('곡 정보 파싱').first().json.songs;\nconst likes = {};\nfor (const l of $input.first().json.contsLike || []) likes[l.CONTSID] = l.SUMMCNT;\nreturn songs.map(s => ({\n  json: {\n    순위: s.rank,\n    곡제목: s.title,\n    가수: s.artist,\n    좋아요수: likes[s.id] ?? 0,\n  },\n}));"
      },
