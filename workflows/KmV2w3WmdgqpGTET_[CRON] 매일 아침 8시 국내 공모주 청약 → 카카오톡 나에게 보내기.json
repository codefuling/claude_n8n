    {
      "id": "c1",
      "name": "이번 주 공모주 10개 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        100
      ],
      "parameters": {
        "jsCode": "// KRX KIND 공모기업현황 HTML → 이번 주(오늘~+7일) 청약 진행/예정 종목 최대 10개\nconst html = String($input.first().json.data ?? $input.first().json ?? '');\nconst kst = (d) => new Date(d).toLocaleDateString('sv-SE', { timeZone: 'Asia/Seoul' });\nconst today = kst(Date.now());\nconst weekEnd = kst(Date.now() + 7 * 86400000);\nconst strip = (s) => s.replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\\s+/g, ' ').trim();\n\nconst rows = [];\nfor (const tr of html.split(/<tr[\\s>]/).slice(1)) {\n  const tds = [...tr.matchAll(/<td[^>]*>([\\s\\S]*?)<\\/td>/g)].map((m) => m[1]);\n  if (tds.length < 9) continue;\n  const name = strip(tds[0]);\n  const market = /코스닥/.test(tds[0]) ? '코스닥' : /코넥스/.test(tds[0]) ? '코넥스' : '유가';\n  const sub = strip(tds[3]).match(/\\d{4}-\\d{2}-\\d{2}/g);\n  if (!sub || sub.length < 2) continue;\n  const [start, end] = sub;\n  if (end < today || start > weekEnd) continue;\n  rows.push({ name, market, start, end, price: strip(tds[5]), listing: strip(tds[7]), broker: strip(tds[8]) });\n}\nrows.sort((a, b) => a.start.localeCompare(b.start));\nconst top = rows.slice(0, 10);\n\nconst md = (d) => d.slice(5).replace('-', '/');\nconst lines = top.map((r, i) => {\n  const state = r.start <= today ? '진행중' : '예정';\n  const price = r.price && r.price !== '-' ? ` ${r.price}원` : '';\n  return `${i + 1}. ${r.name}(${r.market}) ${md(r.start)}~${md(r.end)} ${state}${price}`;\n});\nconst header = `📈 이번주 공모주 청약 (${md(today)} 기준, ${top.length}건)`;\nif (!lines.length) lines.push('이번 주 청약 진행/예정 공모주가 없습니다.');\n\n// 카카오 기본 텍스트 템플릿은 200자 제한 → 200자 이내로 나눠 전송\nconst chunks = [];\nlet cur = header;\nfor (const l of lines) {\n  if ((cur + '\\n' + l).length > 190) { chunks.push(cur); cur = l; }\n  else cur += '\\n' + l;\n}\nchunks.push(cur);\nconst link = 'https://kind.krx.co.kr/listinvstg/pubofrprogcom.do?method=searchPubofrProgComMain';\nreturn chunks.map((text) => ({ json: { text, link } }));"
      }
    },
